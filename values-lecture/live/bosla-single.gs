te; top:-1.6em; right:-2.5em; width:5em; text-align:center; font-size:.7em; font-weight:700; color:var(--lapis); white-space:nowrap; }\n  .casebox { background:var(--card); border-radius:1em; padding:.8em 1.1em; border-right:6px solid var(--copper); }\n  .casebox h3 { font-size:1.3em; margin-bottom:.2em; }\n  .casebox p { margin:0; font-size:.95em; }\n  .keybtn { align-self:flex-start; border:1px solid var(--line); background:#fff; color:var(--copper-d); font-weight:700; font-size:.8em; border-radius:2em; padding:.3em .9em; }\n  table { border-collapse:separate; border-spacing:0; width:100%; background:var(--card); border-radius:1em; overflow:hidden; }\n  th, td { padding:.5em .8em; text-align:right; border-bottom:1px solid var(--line); }\n  th { background:var(--lapis); color:#fff; font-family:'Reem Kufi', Tahoma, sans-serif; font-weight:600; }\n  tr:last-child td { border-bottom:none; }\n  td.num { font-variant-numeric:tabular-nums; font-weight:700; }\n  .hi { color:var(--blue); }\n  .insights { display:flex; flex-direction:column; gap:.7em; }\n  .ins { background:var(--card); border-radius:1em; padding:.7em 1.1em; border-right:6px solid var(--gold); animation:fade .5s ease both; }\n  .ins b { color:var(--copper-d); }\n\n  footer { display:flex; gap:1em; align-items:center; padding:.3em 1.6em .5em 3.2em; font-size:.72em; color:var(--soft); flex:none; }\n  footer button { border:1px solid var(--line); background:var(--card); color:var(--copper-d); font-weight:700; border-radius:2em; padding:.3em 1em; }\n\n  /* ---------- overlays ---------- */\n  .toast { position:fixed; bottom:1.2em; left:50%; transform:translateX(-50%) translateY(150%); background:var(--lapis); color:#fff; padding:.7em 1.3em; border-radius:2em; font-weight:700; transition:transform .3s; z-index:20; }\n  .toast.on { transform:translateX(-50%) translateY(0); }\n  .help { position:fixed; inset:0; background:rgba(11,16,110,.55); display:none; align-items:center; justify-content:center; z-index:30; }\n  .help.on { display:flex; }\n  .help .box { background:#fff; border-radius:1.2em; padding:1.4em 1.8em; max-width:34em; }\n  .help td { border-bottom:1px solid var(--line); padding:.4em .6em; }\n  .help kbd { display:inline-block; min-width:1.8em; text-align:center; background:var(--sand2); border-radius:.35em; padding:.05em .45em; font-weight:800; font-family:Tahoma, sans-serif; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <pattern id=\"strip\" width=\"38\" height=\"38\" patternUnits=\"userSpaceOnUse\"><rect width=\"38\" height=\"38\" fill=\"#E2E3EA\"/><g fill=\"none\" stroke=\"#E8640A\" stroke-width=\"1.5\"><rect x=\"11\" y=\"11\" width=\"16\" height=\"16\"/><rect x=\"11\" y=\"11\" width=\"16\" height=\"16\" transform=\"rotate(45 19 19)\"/><circle cx=\"19\" cy=\"19\" r=\"3\"/></g></pattern>\n  <pattern id=\"bandp\" width=\"30\" height=\"14\" patternUnits=\"userSpaceOnUse\"><g fill=\"none\" stroke=\"#F07A1E\" stroke-width=\"1.2\"><rect x=\"9\" y=\"2\" width=\"10\" height=\"10\"/><rect x=\"9\" y=\"2\" width=\"10\" height=\"10\" transform=\"rotate(45 14 7)\"/><path d=\"M0 7H4M26 7H30\"/></g></pattern>\n</defs></svg>\n\n<header>\n  <div class=\"title\"><span class=\"brand\">بوصلتك الداخلية · نتائج القاعة مباشرة</span><h1 id=\"htitle\">الأنشطة التفاعلية</h1></div>\n  <nav id=\"nav\">\n    <button data-v=\"join\" class=\"on\">انضم</button>\n    <button data-v=\"jobs\" data-act=\"jobs\">الوظيفتان</button>\n    <button data-v=\"discover\" data-act=\"discover\">اكتشف قيمك</button>\n    <button data-v=\"polls\" data-act=\"lead help exam\">التصويتات</button>\n    <button data-v=\"conflict\" data-act=\"c1 c2 c3 c4 c5 c6\">صراع القيم</button>\n    <button data-v=\"share\" data-act=\"share\">البيت</button>\n    <button data-v=\"card\" data-act=\"card\">بطاقة قيمي</button>\n  </nav>\n  <div class=\"presence\" title=\"المنضمون إلى الجلسة · المتصلون الآن\"><span class=\"dot\"></span><b id=\"hJoined\">٠</b>منضم · <b id=\"hOnline\">٠</b>متصل</div>\n  <button class=\"tool\" id=\"btnPresent\" title=\"وضع العرض (P)\">⛶</button>\n  <button class=\"tool help\" id=\"btnHelp\" title=\"اختصارات لوحة المفاتيح (?)\">؟</button>\n  <div class=\"miniqr\" id=\"miniqr\" title=\"رمز الانضمام\"></div>\n</header>\n<svg class=\"band\" viewBox=\"0 0 1200 14\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\"><rect width=\"1200\" height=\"14\" fill=\"url(#bandp)\"/></svg>\n\n<main>\n  <svg class=\"strip\" aria-hidden=\"true\"><rect width=\"38\" height=\"100%\" fill=\"url(#strip)\"/></svg>\n\n  <!-- join -->\n  <section class=\"view on\" id=\"v-join\">\n    <div class=\"join\">\n      <div class=\"txt\">\n        <span class=\"eb\">امسح الرمز بكاميرا جوالك</span>\n        <h2>انضم إلى أنشطة المحاضرة</h2>\n        <p style=\"margin:0\">امسح الرمز مرة واحدة وأبقِ الصفحة مفتوحة. كل نشاط يبدأ سيظهر على جوالك تلقائيًا، بلا اسم ولا تسجيل دخول.</p>\n        <div class=\"counts\">\n          <div><div class=\"num\" id=\"jJoined\">٠</div><div class=\"lab\">طالبًا انضموا</div></div>\n          <div><div class=\"num on\" id=\"jOnline\">٠</div><div class=\"lab\">متصلون الآن</div></div>\n        </div>\n        <div class=\"crowd\" id=\"crowd\" aria-hidden=\"true\"></div>\n        <p style=\"margin:0; font-weight:700\" id=\"joinAct\"></p>\n        <div class=\"url\" id=\"url\"></div>\n      </div>\n      <div class=\"qr\" id=\"qr\"></div>\n    </div>\n  </section>\n\n  <!-- jobs -->\n  <section class=\"view\" id=\"v-jobs\">\n    <div class=\"ctrl\" data-act=\"jobs\"></div>\n    <span class=\"eb\">النشاط الافتتاحي</span>\n    <h2>أيّ العرضين اختارت القاعة؟</h2>\n    <div class=\"veil\"></div>\n    <div class=\"res\"><div class=\"big-rows\" id=\"jobs-bars\"></div><div class=\"insights\" id=\"jobs-read\" style=\"margin-top:1em\"></div></div>\n  </section>\n\n  <!-- discover -->\n  <section class=\"view\" id=\"v-discover\">\n    <div class=\"ctrl\" data-act=\"discover\"></div>\n    <div class=\"veil\"></div>\n    <div class=\"res\" style=\"display:flex; flex-direction:column; gap:.9em\">\n      <div class=\"sub\" id=\"dsub\">\n        <button data-p=\"rank\" class=\"on\">ترتيب القاعة</button><button data-p=\"top\">أعلى قيمة</button><button data-p=\"items\">المواقف</button><button data-p=\"groups\">المجموعات</button><button data-p=\"read\">قراءة سريعة</button>\n      </div>\n      <div class=\"panel on\" id=\"p-rank\">\n        <h2>ترتيب قيم القاعة</h2>\n        <div class=\"legend\">\n          <span>العمود: هذه القاعة</span>\n          <span><i style=\"width:4px;height:1.2em;background:var(--lapis);border-radius:2px\"></i>طلبة جامعتكم في الدراسة (ن = 157)</span>\n          <span><i style=\"width:4px;height:1.2em;background:var(--gold);border-radius:2px\"></i>العينة الكلية (ن = 975)</span>\n        </div>\n        <div class=\"rows\" id=\"rank\"></div>\n        <p class=\"note\">القاعة أجابت عن 12 موقفًا من المقياس (موقفان لكل قيمة)، والدراسة استخدمت المقياس كاملًا (79 موقفًا). المقارنة توضيحية وليست اختبارًا إحصائيًا.</p>\n      </div>\n      <div class=\"panel\" id=\"p-top\"><h2>كم طالبًا كانت هذه أعلى قيمه؟</h2><div class=\"tiles\" id=\"tiles\"></div><p class=\"note\">من تعادلت لديه أعلى قيمتين أو أكثر يُوزَّع صوته بينها بالتساوي.</p></div>\n      <div class=\"panel\" id=\"p-items\"><h2>ماذا اختارت القاعة في كل موقف؟</h2><div class=\"items\" id=\"items\"></div></div>\n      <div class=\"panel\" id=\"p-groups\"><h2>بين الكليات، وبين الطلاب والطالبات</h2><div id=\"groups\"></div><p class=\"note\">تظهر المجموعة حين يجيب منها 5 طلبة على الأقل. أرقام وصفية لقاعة واحدة، بلا اختبار دلالة.</p></div>\n      <div class=\"panel\" id=\"p-read\"><h2>قراءة سريعة في نتائج القاعة</h2><div class=\"insights\" id=\"insights\"></div></div>\n    </div>\n  </section>\n\n  <!-- polls -->\n  <section class=\"view\" id=\"v-polls\">\n    <div class=\"sub\" id=\"psub\"><button data-a=\"lead\" class=\"on\">الترشح</button><button data-a=\"help\">المساعدة المالية</button><button data-a=\"exam\">الامتحان والمقال</button></div>\n    <div class=\"ctrl\" id=\"pctrl\" data-act=\"lead\"></div>\n    <h2 id=\"poll-q\"></h2>\n    <div class=\"veil\"></div>\n    <div class=\"res\">\n      <div class=\"legend\"><span>العمود: هذه القاعة</span><span><i style=\"width:5px;height:1.2em;background:var(--lapis);border-radius:2px\"></i>طلبة جامعتكم في الدراسة</span></div>\n      <div class=\"big-rows\" id=\"poll-bars\"></div>\n      <div class=\"insights\" id=\"poll-read\" style=\"margin-top:1em\"></div>\n    </div>\n  </section>\n\n  <!-- conflict -->\n  <section class=\"view\" id=\"v-conflict\">\n    <div class=\"sub\" id=\"csub\"></div>\n    <div class=\"ctrl\" id=\"cctrl\" data-act=\"c1\"></div>\n    <div class=\"casebox\" id=\"casebox\"></div>\n    <div class=\"veil\"></div>\n    <div class=\"res\" style=\"display:flex; flex-direction:column; gap:.8em\">\n      <h3>ما القيمتان المتصارعتان في رأي القاعة؟</h3>\n      <div class=\"rows\" id=\"c-rows\"></div>\n      <div class=\"insights\" id=\"c-read\"></div>\n      <button class=\"keybtn\" id=\"keybtn\">اعرض مفتاح المحاضر</button>\n      <div class=\"insights\" id=\"c-key\" style=\"display:none\"></div>\n    </div>\n  </section>\n\n  <!-- home -->\n  <section class=\"view\" id=\"v-share\">\n    <div class=\"ctrl\" data-act=\"share\"></div>\n    <h2>القيم التي تعلّمناها في بيوتنا</h2>\n    <div class=\"veil\"></div>\n    <div class=\"res\" style=\"display:flex; flex-direction:column; gap:.9em; flex:1\"><div class=\"tiles\" id=\"share-tiles\"></div><div class=\"insights\" id=\"share-read\"></div></div>\n  </section>\n\n  <!-- card -->\n  <section class=\"view\" id=\"v-card\">\n    <div class=\"ctrl\" data-act=\"card\"></div>\n    <h2>بوصلة القاعة</h2>\n    <div class=\"veil\"></div>\n    <div class=\"res\" style=\"display:flex; flex-direction:column; gap:.9em\">\n      <div style=\"display:flex; gap:2em; flex-wrap:wrap\">\n        <div style=\"flex:1; min-width:18em\"><h3 style=\"margin-bottom:.6em\">قيم نعتز بها (أهم قيمتين)</h3><div class=\"rows\" id=\"card-top\"></div></div>\n        <div style=\"flex:1; min-width:18em\"><h3 style=\"margin-bottom:.6em\">قيم نريد أن ننمّيها</h3><div class=\"rows\" id=\"card-grow\"></div></div>\n      </div>\n      <div class=\"insights\" id=\"card-read\"></div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <span id=\"upd\">جارٍ الاتصال…</span>\n  <span style=\"margin-right:auto\"></span>\n  <button id=\"newsess\">جلسة جديدة</button>\n</footer>\n\n<div class=\"toast\" id=\"toast\"></div>\n<div class=\"help\" id=\"help\"><div class=\"box\">\n  <h3 style=\"margin-bottom:.6em\">اختصارات لوحة المفاتيح</h3>\n  <table>\n    <tr><td><kbd>0</kbd> إلى <kbd>6</kbd></td><td>التبويبات بالترتيب: انضم، الوظيفتان، اكتشف قيمك، التصويتات، صراع القيم، البيت، بطاقة قيمي</td></tr>\n    <tr><td><kbd>مسافة</kbd></td><td>تفعيل النشاط الظاهر على الجوالات أو إيقافه</td></tr>\n    <tr><td><kbd>R</kbd></td><td>كشف النتائج أو إخفاؤها</td></tr>\n    <tr><td><kbd>←</kbd> <kbd>→</kbd></td><td>التصويت أو الحالة التالية والسابقة</td></tr>\n    <tr><td><kbd>P</kbd></td><td>وضع العرض: يخفي القوائم ويكبّر النتائج</td></tr>\n    <tr><td><kbd>F11</kbd></td><td>ملء الشاشة (من المتصفح)</td></tr>\n    <tr><td><kbd>?</kbd></td><td>هذه النافذة</td></tr>\n  </table>\n  <p class=\"note\" style=\"margin-top:.8em\">اضغط في أي مكان للإغلاق.</p>\n</div></div>\n\n<script>\n  var STUDENT_URL = <?!= JSON.stringify(studentUrl) ?>;\n  var KEY = <?!= JSON.stringify(key) ?>;\n\n  var VALUES = [\n    { name:'العلمية', color:'#3C5CA8', tu:2.24, all:2.29 },\n    { name:'الاقتصادية', color:'#E8640A', tu:2.13, all:2.10 },\n    { name:'الاجتماعية', color:'#0E7C86', tu:2.37, all:2.41 },\n    { name:'الجمالية', color:'#A3305F', tu:2.21, all:2.26 },\n    { name:'السياسية', color:'#5C5A1C', tu:2.16, all:2.17 },\n    { name:'الدينية', color:'#1F7A4A', tu:2.55, all:2.59 }\n  ];\n  var ACT_NAMES = { jobs:'العرضان الوظيفيان', discover:'اكتشف قيمك', lead:'تصويت الترشح', help:'تصويت المساعدة المالية', exam:'تصويت الامتحان والمقال', share:'قيمة من البيت', card:'بطاقة قيمي',\n    c1:'صراع القيم: عرس أخي', c2:'صراع القيم: عرض الدقم', c3:'صراع القيم: كود الصديق', c4:'صراع القيم: متجر إنستغرام', c5:'صراع القيم: مجلس الطلبة', c6:'صراع القيم: تصميم المشروع' };\n  var ITEMS = [\"عرض لموضوع في مقرر\", \"جائزة مالية من مسابقة\", \"زميل يتم تهميشه\", \"معرض للفنون في الجامعة\", \"انتخابات المجلس الطلابي\", \"محاضرات في مسجد الجامعة\", \"دورات مهارات البحث\", \"تعطّل الحاسوب\", \"زميل يطلب شرح الدروس\", \"ورشة التصوير الفوتوغرافي\", \"تمثيل الدفعة\", \"منحة مالية تكفي حاجتك\"];\n  // نسب الدراسة لطلبة جامعتكم. \"ب\" في الامتحان محسوبة بالطرح من 100، وفي المساعدة المالية تُعرف نسبة \"أ\" وحدها.\n  var POLLS = {\n    lead: { q:'تم ترشيحك لرئاسة جماعة طلابية في الجامعة', opts:['تقبل لأنك تستمتع بالقيادة', 'تترشح إن وجدت الدعم الكافي', 'ترفض تحمّل المسؤولية'], study:[33, 31, 36] },\n    help: { q:'تعرّض أحد زملائك لضائقة مالية وأنت على علم بذلك', opts:['تقدّم له الدعم بقدر الاستطاعة', 'تخبر زملاءك ليجمعوا التبرعات', 'لا تهتم بأمره'], study:[80, null, null] },\n    exam: { q:'لديك امتحان غدًا، وتجد مقالًا مثيرًا لاهتمامك', opts:['تقرأ المقال لأنه يوسّع معرفتك', 'تقسم وقتك بين المقال والمذاكرة', 'تركز على المذاكرة وتترك المقال'], study:[11, 30, 59] }\n  };\n  var JOBS = ['شركة كبرى في مسقط، راتب أعلى', 'مؤسسة قريبة، عمل ذو معنى'];\n  var CASES = [\n    ['عرس أخي', 'زفاف أخيك الليلة في الولاية، وامتحانك النهائي صباح الغد.', [2, 0]],\n    ['عرض الدقم', 'راتب يقارب الضعف في الدقم، أو عمل قريب من والديك المسنّين.', [1, 2]],\n    ['كود الصديق', 'صديقك يطلب جزءًا من كود مشروعك ليسلّمه باسمه.', [2, 5]],\n    ['متجر إنستغرام', 'المبالغة في وصف المنتج تضاعف المبيعات.', [1, 5]],\n    ['مجلس الطلبة', 'نجحت في الانتخابات، والمهام تأكل وقت مذاكرتك.', [4, 0]],\n    ['تصميم المشروع', 'الواجهة الأجمل تكلّف ضعف الميزانية، والأبسط تكفي.', [3, 1]]\n  ];\n  var COLLEGES = { eng:'الهندسة', it:'تقنية المعلومات', bus:'الاقتصاد وإدارة الأعمال', other:'أخرى' };\n  var GENDERS = { m:'الطلاب', f:'الطالبات' };\n  var MIN_GROUP = 5;\n\n  var AR = '٠١٢٣٤٥٦٧٨٩';\n  function ar(n) { return String(n).replace(/[0-9]/g, function (d) { return AR[d]; }); }\n  function pc(x) { return ar(Math.round(x)) + '٪'; }\n  function f2(x) { return x.toFixed(2); }\n  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  function B(t) { return el('b', null, t); }\n  function insight(box, parts) { var p = el('div', 'ins'); parts.forEach(function (x) { p.appendChild(typeof x === 'string' ? document.createTextNode(x) : x); }); box.appendChild(p); }\n  function parse(s) { try { return JSON.parse(s); } catch (e) { return null; } }\n  function toast(t) { var e = document.getElementById('toast'); e.textContent = t; e.classList.add('on'); clearTimeout(toast.t); toast.t = setTimeout(function () { e.classList.remove('on'); }, 2600); }\n\n  /* animated numbers */\n  var shownNum = {};\n  function countTo(node, id, target) {\n    var from = shownNum[id] || 0; shownNum[id] = target;\n    if (from === target) { node.textContent = ar(target); return; }\n    if (target > from) { node.classList.remove('bump'); void node.offsetWidth; node.classList.add('bump'); }\n    var t0 = performance.now(), dur = 700;\n    (function step(t) { var k = Math.min(1, (t - t0) / dur); node.textContent = ar(Math.round(from + (target - from) * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); })(t0);\n  }\n\n  /* ---------- QR ---------- */\n  document.getElementById('url').textContent = STUDENT_URL;\n  try {\n    var q = qrcode(0, 'M'); q.addData(STUDENT_URL); q.make();\n    document.getElementById('qr').innerHTML = q.createSvgTag({ cellSize: 8, margin: 2, scalable: true });\n    document.getElementById('miniqr').innerHTML = q.createSvgTag({ cellSize: 2, margin: 1, scalable: true });\n  } catch (e) { document.getElementById('qr').textContent = 'تعذّر رسم الرمز. انسخ الرابط الظاهر بجانبه.'; }\n\n  /* ---------- navigation ---------- */\n  var VIEWS = ['join', 'jobs', 'discover', 'polls', 'conflict', 'share', 'card'];\n  var view = 'join', pollAct = 'lead', caseAct = 'c1';\n  function showView(v) {\n    view = v;\n    document.querySelectorAll('#nav button').forEach(function (x) { x.classList.toggle('on', x.getAttribute('data-v') === v); });\n    document.querySelectorAll('.view').forEach(function (x) { x.classList.toggle('on', x.id === 'v-' + v); });\n    applyVeils(); refresh();\n  }\n  document.querySelectorAll('#nav button').forEach(function (b) { b.onclick = function () { showView(b.getAttribute('data-v')); }; });\n  document.querySelectorAll('#dsub button').forEach(function (b) {\n    b.onclick = function () {\n      var p = b.getAttribute('data-p');\n      document.querySelectorAll('#dsub button').forEach(function (x) { x.classList.toggle('on', x === b); });\n      document.querySelectorAll('#v-discover .panel').forEach(function (x) { x.classList.toggle('on', x.id === 'p-' + p); });\n    };\n  });\n  function setPoll(a) {\n    pollAct = a;\n    document.querySelectorAll('#psub button').forEach(function (x) { x.classList.toggle('on', x.getAttribute('data-a') === a); });\n    document.getElementById('pctrl').setAttribute('data-act', a);\n    document.getElementById('poll-q').textContent = POLLS[a].q;\n    drawCtrls(); applyVeils(); refresh();\n  }\n  document.querySelectorAll('#psub button').forEach(function (b) { b.onclick = function () { setPoll(b.getAttribute('data-a')); }; });\n  var csub = document.getElementById('csub');\n  CASES.forEach(function (c, i) {\n    var b = el('button', i === 0 ? 'on' : '', ar(i + 1) + ' · ' + c[0]); b.setAttribute('data-a', 'c' + (i + 1));\n    b.onclick = function () { setCase('c' + (i + 1)); }; csub.appendChild(b);\n  });\n  var keyShown = false;\n  function setCase(a) {\n    caseAct = a; keyShown = false;\n    var ci = Number(a.slice(1)) - 1;\n    csub.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x.getAttribute('data-a') === a); });\n    document.getElementById('cctrl').setAttribute('data-act', a);\n    var box = document.getElementById('casebox'); box.innerHTML = '';\n    box.appendChild(el('h3', null, 'الحالة ' + ar(ci + 1) + ' · ' + CASES[ci][0])); box.appendChild(el('p', null, CASES[ci][1]));\n    document.getElementById('c-key').style.display = 'none';\n    document.getElementById('keybtn').textContent = 'اعرض مفتاح المحاضر';\n    drawCtrls(); applyVeils(); refresh();\n  }\n  document.getElementById('keybtn').onclick = function () {\n    keyShown = !keyShown;\n    document.getElementById('c-key').style.display = keyShown ? 'flex' : 'none';\n    this.textContent = keyShown ? 'أخفِ مفتاح المحاضر' : 'اعرض مفتاح المحاضر';\n  };\n  function visibleAct() { return view === 'join' ? null : view === 'polls' ? pollAct : view === 'conflict' ? caseAct : view; }\n\n  /* ---------- reveal ---------- */\n  var revealed = {};\n  function applyVeils() {\n    document.querySelectorAll('.view').forEach(function (v) {\n      var id = v.id.slice(2), act = id === 'polls' ? pollAct : id === 'conflict' ? caseAct : id;\n      v.classList.toggle('hidden-res', id !== 'join' && !revealed[act]);\n    });\n  }\n  function toggleReveal(act) { revealed[act] = !revealed[act]; applyVeils(); drawCtrls(); toast(revealed[act] ? 'كُشفت النتائج' : 'أُخفيت النتائج'); refresh(); }\n\n  /* ---------- state & controls ---------- */\n  var state = { act:'', session:'' }, lastN = {}, presence = { joined:0, online:0 };\n  function activate(act) {\n    var live = state.act === act;\n    google.script.run.withSuccessHandler(function (s) { onState(s); toast(live ? 'أُوقف النشاط على الجوالات' : 'فُعّل على الجوالات: ' + ACT_NAMES[act]); }).setActivity(KEY, live ? '' : act);\n  }\n  function drawCtrls() {\n    document.querySelectorAll('.ctrl').forEach(function (c) {\n      var act = c.getAttribute('data-act'), live = state.act === act, n = lastN[act] || 0;\n      c.innerHTML = '';\n      var go = el('button', 'go' + (live ? ' stop' : ''), live ? 'أوقف على الجوالات' : 'فعّل على الجوالات');\n      go.onclick = function () { activate(act); };\n      var rv = el('button', 'rev' + (revealed[act] ? ' on' : ''), revealed[act] ? 'أخفِ النتائج' : 'اكشف النتائج');\n      rv.onclick = function () { toggleReveal(act); };\n      c.appendChild(go); c.appendChild(rv);\n      c.appendChild(el('span', 'status' + (live ? ' live' : ''), live ? 'مفعّل الآن على الجوالات' : 'غير مفعّل'));\n      var m = el('span', 'meter'); var b = el('b', null, ar(n));\n      m.appendChild(b); m.appendChild(document.createTextNode('أجابوا من ' + ar(presence.joined)));\n      var bar = el('span', 'mbar'), f = el('div'); f.style.width = (presence.joined ? Math.min(100, n / presence.joined * 100) : 0) + '%'; bar.appendChild(f); m.appendChild(bar);\n      c.appendChild(m);\n    });\n    document.querySelectorAll('#nav button').forEach(function (b) {\n      var acts = (b.getAttribute('data-act') || '').split(' ');\n      b.classList.toggle('live', !!state.act && acts.indexOf(state.act) >= 0);\n    });\n    document.querySelectorAll('#psub button, #csub button').forEach(function (b) { b.classList.toggle('live', state.act === b.getAttribute('data-a')); });\n    document.getElementById('joinAct').textContent = state.act ? 'النشاط المفعّل الآن: ' + ACT_NAMES[state.act] : 'لا يوجد نشاط مفعّل الآن.';\n    document.getElementById('htitle').textContent = state.act ? ACT_NAMES[state.act] : 'الأنشطة التفاعلية';\n  }\n  function onState(s) { state = { act: s.act, session: s.session }; drawCtrls(); }\n\n  function drawPresence() {\n    countTo(document.getElementById('hJoined'), 'hj', presence.joined);\n    countTo(document.getElementById('hOnline'), 'ho', presence.online);\n    countTo(document.getElementById('jJoined'), 'jj', presence.joined);\n    countTo(document.getElementById('jOnline'), 'jo', presence.online);\n    var crowd = document.getElementById('crowd'), want = Math.min(presence.joined, 160);\n    while (crowd.children.length < want) { var d = el('span'); d.style.animationDelay = (crowd.children.length % 12) * 30 + 'ms'; crowd.appendChild(d); }\n    while (crowd.children.length > want) crowd.removeChild(crowd.lastChild);\n    Array.prototype.forEach.call(crowd.children, function (d, i) { d.classList.toggle('off', i >= presence.online); });\n  }\n\n  function drawVeil(act) {\n    var v = document.querySelector('.view.on .veil'); if (!v) return;\n    var n = lastN[act] || 0, j = presence.joined;\n    v.innerHTML = '';\n    var big = el('div', 'big'); v.appendChild(big); countTo(big, 'veil-' + act, n);\n    v.appendChild(el('div', 'of', 'أجاب ' + ar(n) + ' من ' + ar(j) + ' طالبًا'));\n    var r = el('div', 'ring'), f = el('div'); f.style.width = (j ? Math.min(100, n / j * 100) : 0) + '%'; r.appendChild(f); v.appendChild(r);\n    v.appendChild(el('div', 'hint', state.act === act ? 'النتائج مخفية حتى تكشفها، حتى لا تتأثر إجابات القاعة' : 'فعّل النشاط على الجوالات، ثم اكشف النتائج حين يكتمل العدد'));\n  }\n\n  /* ---------- polling ---------- */\n  var busy = false;\n  function refresh() {\n    if (busy) return; busy = true;\n    var act = visibleAct();\n    google.script.run.withSuccessHandler(onState).getState();\n    google.script.run\n      .withSuccessHandler(function (d) {\n        busy = false;\n        presence = { joined: d.joined, online: d.online }; drawPresence();\n        if (act) { lastN[act] = d.rows.length; }\n        drawCtrls();\n        if (act && act === visibleAct()) { RENDER[/^c\\d$/.test(act) ? 'conflict' : act](d.rows, act); drawVeil(act); }\n        document.getElementById('upd').textContent = 'آخر تحديث ' + new Date(d.at).toLocaleTimeString('ar-OM') + ' · الجلسة ' + d.session;\n      })\n      .withFailureHandler(function () { busy = false; document.getElementById('upd').textContent = 'تعذّر التحديث، ستُعاد المحاولة تلقائيًا…'; })\n      .getResults(KEY, act || '');\n  }\n  setInterval(refresh, 3500);\n\n  document.getElementById('newsess').onclick = function () {\n    if (!confirm('بدء جلسة جديدة يخفي إجابات الجلسة الحالية من اللوحة ويصفّر عدد المنضمين ويوقف النشاط المفعّل (تبقى الإجابات محفوظة في جدول Google). على الطلبة بعدها إعادة تحميل الصفحة أو الانتظار حتى تنضم جوالاتهم تلقائيًا. هل تريد المتابعة؟')) return;\n    google.script.run.withSuccessHandler(function (s) { onState(s); lastN = {}; revealed = {}; applyVeils(); refresh(); toast('بدأت جلسة جديدة'); }).startNewSession(KEY);\n  };\n\n  /* ---------- presentation & keyboard ---------- */\n  function togglePresent() { document.body.classList.toggle('present'); toast(document.body.classList.contains('present') ? 'وضع العرض: اضغط P للخروج، وF11 لملء الشاشة' : 'خرجت من وضع العرض'); }\n  document.getElementById('btnPresent').onclick = togglePresent;\n  document.getElementById('btnHelp').onclick = function () { document.getElementById('help').classList.add('on'); };\n  document.getElementById('help').onclick = function () { this.classList.remove('on'); };\n  document.addEventListener('keydown', function (e) {\n    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;\n    var k = e.key;\n    if (/^[0-6]$/.test(k)) { showView(VIEWS[Number(k)]); return; }\n    if (k === '٠' || k === '١' || k === '٢' || k === '٣' || k === '٤' || k === '٥' || k === '٦') { showView(VIEWS[AR.indexOf(k)]); return; }\n    var act = visibleAct();\n    if (k === ' ' && act) { e.preventDefault(); activate(act); return; }\n    if ((k === 'r' || k === 'R' || k === 'ق') && act) { toggleReveal(act); return; }\n    if (k === 'p' || k === 'P' || k === 'ح') { togglePresent(); return; }\n    if (k === '?' || k === '؟') { document.getElementById('help').classList.toggle('on'); return; }\n    if (k === 'Escape') { document.getElementById('help').classList.remove('on'); return; }\n    if (k === 'ArrowLeft' || k === 'ArrowRight') {\n      var dir = k === 'ArrowLeft' ? 1 : -1;\n      if (view === 'polls') { var P = ['lead', 'help', 'exam']; setPoll(P[(P.indexOf(pollAct) + dir + 3) % 3]); }\n      else if (view === 'conflict') { var c = Number(caseAct.slice(1)) - 1; setCase('c' + ((c + dir + 6) % 6 + 1)); }\n    }\n  });\n\n  /* ---------- drawing helpers ---------- */\n  function bigBars(box, labels, counts, study) {\n    box.innerHTML = '';\n    var tot = counts.reduce(function (a, b) { return a + b; }, 0);\n    labels.forEach(function (lab, i) {\n      var row = el('div', 'brow'); row.style.animationDelay = i * 90 + 'ms';\n      row.appendChild(el('span', 'blet ' + ['sa', 'sb', 'sc'][i], 'أبج'[i]));\n      row.appendChild(el('span', 'btext', lab));\n      var tr = el('div', 'btrack');\n      var f = el('div', 'bfill'); f.style.background = ['#0B106E', '#F07A1E', '#9AA3B5'][i]; f.style.width = (tot ? counts[i] / tot * 100 : 0) + '%';\n      tr.appendChild(f);\n      if (study && study[i] != null) { var m = el('div', 'smark'); m.style.right = study[i] + '%'; m.appendChild(el('span', null, 'الدراسة ' + pc(study[i]))); tr.appendChild(m); }\n      row.appendChild(tr);\n      row.appendChild(el('span', 'bpct', tot ? pc(counts[i] / tot * 100) : '—'));\n      box.appendChild(row);\n    });\n    return tot;\n  }\n  function countLetters(rows, n) { var c = [0, 0, 0].slice(0, n); rows.forEach(function (r) { var i = 'abc'.indexOf(r[2]); if (i >= 0 && i < n) c[i]++; }); return c; }\n  function valueRows(box, counts, denom) {\n    box.innerHTML = '';\n    var order = [0, 1, 2, 3, 4, 5].sort(function (x, y) { return counts[y] - counts[x]; });\n    order.forEach(function (i, k) {\n      var v = VALUES[i], row = el('div', 'vrow'); row.style.animationDelay = k * 70 + 'ms';\n      var nm = el('div', 'vname'); var ch = el('span', 'chip', v.name); ch.style.background = v.color; nm.appendChild(ch);\n      var tr = el('div', 'track'), fi = el('div', 'fill'); fi.style.background = v.color; fi.style.width = (denom ? counts[i] / denom * 100 : 0) + '%'; tr.appendChild(fi);\n      row.appendChild(nm); row.appendChild(tr); row.appendChild(el('div', 'vval', denom ? pc(counts[