er-radius:20px; padding:6px 14px; font-weight:700; color:#fff; }\n  .vcard .sub { color:var(--gold); font-weight:700; font-size:14px; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <pattern id=\"bandp\" width=\"26\" height=\"20\" patternUnits=\"userSpaceOnUse\"><g fill=\"none\" stroke=\"#F07A1E\" stroke-width=\"1.2\"><rect x=\"7\" y=\"4\" width=\"12\" height=\"12\"/><rect x=\"7\" y=\"4\" width=\"12\" height=\"12\" transform=\"rotate(45 13 10)\"/><path d=\"M0 10H3M23 10H26\"/></g></pattern>\n</defs></svg>\n\n<div class=\"banner\" id=\"banner\">بدأ نشاط جديد<button id=\"bannerGo\">انتقل إليه</button></div>\n<header class=\"top\">\n  <div class=\"brand\"><span style=\"display:inline-block;width:8px;height:8px;background:var(--gold);transform:rotate(45deg)\"></span>بوصلتك الداخلية · رحلة في عالم القيم</div>\n  <h1 id=\"title\">أهلًا بك</h1>\n  <svg class=\"band\" viewBox=\"0 0 520 20\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\"><rect width=\"520\" height=\"20\" fill=\"url(#bandp)\"/></svg>\n</header>\n\n<main id=\"main\"></main>\n\n<script>\n  /* ================= المحتوى: عدّل النصوص هنا ================= */\n  var VALUES = [\n    ['العلمية', '#3C5CA8'], ['الاقتصادية', '#E8640A'], ['الاجتماعية', '#0E7C86'],\n    ['الجمالية', '#A3305F'], ['السياسية', '#5C5A1C'], ['الدينية', '#1F7A4A']\n  ];\n  var TITLES = {\n    jobs: 'العرضان الوظيفيان', discover: 'اكتشف قيمك', lead: 'تصويت: الترشح', help: 'تصويت: المساعدة المالية',\n    exam: 'تصويت: الامتحان والمقال', share: 'قيمة من البيت', card: 'بطاقة قيمي',\n    c1: 'صراع القيم', c2: 'صراع القيم', c3: 'صراع القيم', c4: 'صراع القيم', c5: 'صراع القيم', c6: 'صراع القيم'\n  };\n  var JOBS = { q: 'تخرّجت، وأمامك عرضان. أيّهما تختار؟', a: ['شركة كبرى في مسقط', 'راتب مرتفع وحوافز، وساعات عمل طويلة، وبُعد عن الأهل والولاية'], b: ['مؤسسة قريبة من بيتك', 'راتب أقل، وعمل تشعر بقيمته ومعناه، ووقت كافٍ للأسرة والمجتمع'] };\n  // نصوص المواقف الثلاثة حرفيًا من الصورة النهائية للمقياس (الملحق 5)\n  var POLLS = {\n    lead: ['تم ترشيحك لرئاسة جماعة طلابية في الجامعة، ماذا تفعل؟', 'تقبل الترشح لأنك تستمتع بالقيادة.', 'تترشح فقط إذا وجدت الدعم الكافي من زملائك.', 'ترفض الترشح لأنك لا ترغب في تحمل المسؤولية.'],\n    help: ['تعرّض أحد زملائك لضائقة مالية وأنت على علم بذلك، ماذا تفعل؟', 'تقدّم له الدعم بقدر الاستطاعة.', 'تخبر زملاءك ليجمعوا له التبرعات.', 'لا تهتم بأمره.'],\n    exam: ['لديك امتحان غدًا، ولكنك تجد مقالًا مثيرًا لاهتمامك، ماذا تفعل؟', 'تقرأ المقال لأنه يوسّع معرفتك.', 'تقسم وقتك بين المقال والمذاكرة.', 'تركز على المذاكرة للامتحان وتترك المقال لاحقًا.']\n  };\n  // 12 موقفًا من الصورة النهائية للمقياس (الملحق 5): موقفان لكل قيمة، بالتناوب\n  var ITEMS = [\n    [\"كُلّفت بتصميم عرض لموضوع في أحد المقررات، ماذا تفعل؟\", \"تقوم بالبحث في مصادر مختلفة وتصميمه بنفسك\", \"تكتفي بالمادة العلمية الجاهزة وتقدّم العرض\", \"تبحث عن عرض جاهز قام به أحد زملائك\"],\n    [\"فزت في إحدى المسابقات الجامعية، وحصلت على جائزة مالية، ماذا تفعل؟\", \"تدّخر المبلغ الذي حصلت عليه\", \"تنفق جزءًا منه وتدّخر الباقي\", \"تنفق المبلغ كاملًا من أجل الترفيه\"],\n    [\"تلاحظ أحد زملائك يتم تهميشه من قبل الآخرين، ماذا تفعل؟\", \"تعمل على إدماجه في المناقشات\", \"تناقشه بشكل منفصل لتقدّم له الدعم\", \"تترك الأمور كما هي ولا تهتم بذلك\"],\n    [\"أُقيم معرض للفنون تُعرض فيه مجموعة من اللوحات المميزة في جامعتك، ماذا تفعل؟\", \"تذهب لزيارة المعرض وتفقّد اللوحات\", \"تسأل زملاءك الذين ذهبوا إلى المعرض\", \"لا تهتم بمثل هذه المعارض\"],\n    [\"لديك فرصة التصويت في انتخابات المجلس الطلابي بالجامعة، ماذا تفعل؟\", \"تختار المرشح الذي يمتلك رؤية وخطة واضحة\", \"تصوّت لصديقك المقرّب بغض النظر عما يقدّمه\", \"تمتنع عن التصويت لأنك غير مهتم بالانتخابات\"],\n    [\"تُقام محاضرات دينية في مسجد الجامعة، ماذا تفعل؟\", \"تذهب للاستماع وتحثّ زملاءك على الحضور\", \"تحضر إذا لم يكن معك ضغط دراسي\", \"ترفض الحضور لأنك مشغول بالدراسة\"],\n    [\"تم الإعلان عن إقامة دورات تدريبية في جامعتك حول تطوير مهارات البحث، ماذا تفعل؟\", \"تسارع للتسجيل في الدورة التدريبية\", \"تتردد في التسجيل، وتطّلع على محاور الدورة قبل ذلك\", \"ترفض فكرة الحضور لعدم أهمية الموضوع\"],\n    [\"في أيام الدراسة تعطّل جهازك الحاسوب، ماذا تفعل؟\", \"تُصلح جهازك الحاسوب بسعر معقول\", \"تبحث عن جهاز مستعمل\", \"تشتري جهازًا جديدًا\"],\n    [\"أثناء فترة الامتحانات طلب منك زميلك أن توضّح له بعض الدروس، ماذا تفعل؟\", \"تخصّص له وقتًا للمساعدة\", \"تساعده إن تبقّى لديك وقت بعد المراجعة\", \"تتركه يعتمد على نفسه\"],\n    [\"أقامت جماعة التصوير في جامعتك ورشة حول التصوير الفوتوغرافي، ماذا تفعل؟\", \"تشارك في الورشة لتطوّر مهاراتك\", \"تشارك فيها إذا كانت لا تتعارض مع وقت دراستك\", \"ترفض المشاركة فيها ولا تهتم بها\"],\n    [\"عُرضت عليك فرصة لتكون ممثلًا لدفعتك في تخصصك، ماذا تفعل؟\", \"تقبل الأمر وتعمل على تمثيل الطلاب\", \"تطلب من زميلك المشاركة لأنه شخص قيادي\", \"ترفض ذلك لأنك ترى أنه لا توجد أهمية للأمر\"],\n    [\"تُعطى منحة مالية من الجامعة تكفي حاجتك، ماذا تفعل؟\", \"تحاول أن تخصّص منها جزءًا للصدقة\", \"تتصدّق إذا تبقّى منها شيء بعد قضاء حاجتك\", \"تعتقد أنك أحقّ بهذا المال\"]\n  ];\n  var CASES = [\n    ['عرس أخي', 'زفاف أخيك الأكبر الليلة في الولاية، والأهل ينتظرون حضورك ومساعدتك في استقبال الضيوف. امتحانك النهائي في مقرر صعب الساعة الثامنة صباح الغد، ولم تُنهِ المراجعة بعد. والطريق إلى البيت ساعة ونصف.'],\n    ['عرض الدقم', 'تخرجت مهندسًا، وجاءك عرض من شركة في الدقم براتب يقارب ضعف ما يعرضه مصنع قريب من بيتكم. والداك كبيران في السن، وأنت الابن الوحيد المقيم قريبًا منهما، وإخوتك يعملون خارج الولاية.'],\n    ['كود الصديق', 'صديقك المقرّب منذ المدرسة لم يُنهِ مشروع البرمجة، والتسليم الليلة. يطلب منك أن ترسل له جزءًا من الكود الذي كتبته ليعدّله قليلًا ويسلّمه باسمه، ويقول لك: لو كنت مكاني ما تركتك.'],\n    ['متجر إنستغرام', 'بدأت مع أختك متجرًا صغيرًا على إنستغرام لبيع العطور والبخور. لاحظتما أن المنشورات التي تبالغ في وصف الجودة، مثل \"أصلي 100%\" و\"أفضل عود في عُمان\"، تبيع ضعف غيرها، والمنتج جيد لكنه ليس كما تصفه تلك العبارات.'],\n    ['مجلس الطلبة', 'ترشحت لمجلس الطلبة ونجحت بأصوات زملائك بعد وعود بتحسين خدمات النقل. بعد شهرين وجدت أن الاجتماعات والمتابعات تأخذ أكثر من عشر ساعات أسبوعيًا، وانخفض معدلك، والفصل القادم فيه مقررات تخصص ثقيلة.'],\n    ['تصميم المشروع', 'فريقك يعمل على مشروع تخرج لتطبيق خدمي. أمامكم تصميمان للواجهة: الأول جميل ومتقن ويحتاج شراء أدوات وقوالب بضعف الميزانية المتاحة من جيوبكم، والثاني بسيط ومجاني ويؤدي الوظيفة. وزميلكم المصمم متحمس جدًا للأول.']\n  ];\n  /* ============================================================= */\n\n  var AR = '٠١٢٣٤٥٦٧٨٩';\n  function ar(n) { return String(n).replace(/[0-9]/g, function (d) { return AR[d]; }); }\n  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }\n\n  var CLIENT = store('values-client');\n  if (!CLIENT) { CLIENT = 'c' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10); store('values-client', CLIENT); }\n\n  var state = { act: '', session: '' };\n  var shown = null;      // النشاط المعروض الآن\n  var busy = false;      // الطالب في منتصف نشاط ولم يرسل بعد\n  var main = document.getElementById('main');\n\n  function doneKey(act) { return 'values-done:' + state.session + ':' + act; }\n  function setTitle(t) { document.getElementById('title').textContent = t; }\n  function clear() { main.innerHTML = ''; window.scrollTo(0, 0); }\n\n  /* ---------- polling ---------- */\n  function poll() {\n    google.script.run.withSuccessHandler(onState).withFailureHandler(function () {}).getState(CLIENT);\n  }\n  function joinNow() {\n    google.script.run.withSuccessHandler(onState).withFailureHandler(function () { setTimeout(joinNow, 4000); }).join(CLIENT);\n  }\n  function schedule() { setTimeout(function () { poll(); schedule(); }, 9000 + Math.random() * 5000); }\n  function onState(st) {\n    if (state.session && st.session !== state.session) joinNow();\n    var changed = st.act !== state.act || st.session !== state.session;\n    state = st;\n    if (!changed && shown !== null) return;\n    if (busy && shown && shown !== st.act) { document.getElementById('banner').style.display = st.act ? 'block' : 'none'; return; }\n    render();\n  }\n  document.getElementById('bannerGo').onclick = function () { busy = false; document.getElementById('banner').style.display = 'none'; render(); };\n\n  function render() {\n    document.getElementById('banner').style.display = 'none';\n    shown = state.act;\n    if (!state.act) return renderWait();\n    var saved = store(doneKey(state.act));\n    if (saved) return renderSent(state.act, JSON.parse(saved));\n    var R = { jobs: renderJobs, discover: renderDiscoverIntro, lead: renderPoll, help: renderPoll, exam: renderPoll,\n       c1: renderConflict, c2: renderConflict, c3: renderConflict, c4: renderConflict, c5: renderConflict, c6: renderConflict,\n       share: renderShare, card: renderCard }[state.act];\n    if (R) R(); else renderWait();\n  }\n\n  function renderWait() {\n    busy = false; setTitle('أهلًا بك'); clear();\n    var c = el('div', 'card');\n    c.appendChild(el('h2', null, 'أنت متصل'));\n    c.appendChild(el('p', null, 'ابقَ على هذه الصفحة. حين يبدأ المحاضر نشاطًا سيظهر هنا تلقائيًا.'));\n    c.appendChild(el('p', 'muted', 'إجاباتك بلا اسم، ولا يرى أحد إجابتك الفردية. تظهر على الشاشة نتائج القاعة مجتمعة فقط.'));\n    c.appendChild(el('div', 'spin'));\n    main.appendChild(c);\n  }\n\n  /* ---------- sending ---------- */\n  function send(act, data, extra, view) {\n    clear();\n    var c = el('div', 'card'); c.style.textAlign = 'center'; c.appendChild(el('div', 'spin')); c.appendChild(el('p', null, 'جارٍ الإرسال…')); main.appendChild(c);\n    var payload = { act: act, client: CLIENT, data: data };\n    if (extra) { payload.college = extra.college; payload.gender = extra.gender; }\n    google.script.run\n      .withSuccessHandler(function () { busy = false; store(doneKey(act), JSON.stringify(view || {})); renderSent(act, view || {}); })\n      .withFailureHandler(function () {\n        clear();\n        var e = el('div', 'card');\n        e.appendChild(el('p', null, 'لم تصل الإجابة بسبب الاتصال.'));\n        var b = el('button', 'btn orange', 'أعد الإرسال'); b.onclick = function () { send(act, data, extra, view); };\n        e.appendChild(b); main.appendChild(e);\n      })\n      .submit(payload);\n  }\n\n  function renderSent(act, view) {\n    busy = false; setTitle(TITLES[act]); clear();\n    var c = el('div', 'card');\n    if (act === 'discover' && view.answers) { profileInto(c, view.answers); }\n    else if (act === 'card' && view.top) { cardInto(c, view); }\n    c.appendChild(el('p', 'ok', 'وصلت إجابتك. انظر إلى الشاشة لترى نتائج القاعة.'));\n    c.appendChild(el('p', 'muted', 'سينتقل جوالك تلقائيًا حين يبدأ المحاضر النشاط التالي.'));\n    var again = el('button', 'btn ghost', 'عدّل إجابتي');\n    again.onclick = function () { try { localStorage.removeItem(doneKey(act)); } catch (e) {} render(); };\n    c.appendChild(again);\n    main.appendChild(c);\n  }\n\n  /* ---------- generic choice ---------- */\n  function choiceCard(tagText, q, options, onPick) {\n    clear();\n    var c = el('div', 'card');\n    c.appendChild(el('span', 'tag', tagText));\n    c.appendChild(el('p', 'q', q));\n    options.forEach(function (o, j) {\n      var b = el('button', 'opt');\n      var l = el('span', 'let ' + 'abc'[j], 'أبج'[j]);\n      var t = el('span');\n      if (Array.isArray(o)) { t.appendChild(el('b', null, o[0])); t.appendChild(el('span', 'muted', o[1])); } else { t.textContent = o; }\n      b.appendChild(l); b.appendChild(t);\n      b.onclick = function () { onPick('abc'[j]); };\n      c.appendChild(b);\n    });\n    main.appendChild(c);\n  }\n\n  function renderJobs() {\n    busy = true; setTitle(TITLES.jobs);\n    choiceCard('صوّت', JOBS.q, [JOBS.a, JOBS.b], function (k) { send('jobs', k, null, {}); });\n  }\n\n  function renderPoll() {\n    var act = state.act, p = POLLS[act];\n    busy = true; setTitle(TITLES[act]);\n    choiceCard('صوّت ثم قارن بزملائك في الدراسة', p[0], p.slice(1), function (k) { send(act, k, null, {}); });\n  }\n\n  /* ---------- discover ---------- */\n  var answers, about, cur;\n  function renderDiscoverIntro() {\n    busy = true; setTitle(TITLES.discover); clear();\n    answers = new Array(ITEMS.length).fill(''); about = { college: '', gender: '' }; cur = 0;\n    var c = el('div', 'card');\n    c.appendChild(el('h2', null, '12 موقفًا من حياتك الجامعية'));\n    c.appendChild(el('p', null, 'اختر في كل موقف ما ستفعله فعلًا، لا ما ترى أنه يجب أن تفعله.'));\n    c.appendChild(el('p', 'muted', '12 موقفًا مختارة من مقياس القيم (79 موقفًا)، فالنتيجة للتأمل وليست تشخيصًا.'));\n    var b = el('button', 'btn', 'ابدأ'); b.onclick = renderQ; c.appendChild(b);\n    main.appendChild(c);\n  }\n  function renderQ() {\n    clear();\n    var prog = el('div', 'prog');\n    for (var i = 0; i < ITEMS.length; i++) prog.appendChild(el('span', 'pd' + (i === cur ? ' on' : (answers[i] ? ' done' : ''))));\n    main.appendChild(prog);\n    var it = ITEMS[cur], c = el('div', 'card');\n    var qn = el('div', 'qno'); var st = el('span', 'star'); st.appendChild(el('span', null, ar(cur + 1))); qn.appendChild(st); qn.appendChild(el('span', null, 'موقف ' + ar(cur + 1) + ' من ' + ar(ITEMS.length))); c.appendChild(qn);\n    c.appendChild(el('p', 'q', it[0]));\n    ['a', 'b', 'c'].forEach(function (k, j) {\n      var b = el('button', 'opt' + (answers[cur] === k ? ' sel' : ''));\n      b.appendChild(el('span', 'let ' + k, 'أبج'[j])); b.appendChild(el('span', null, it[j + 1]));\n      b.onclick = function () {\n        answers[cur] = k; b.classList.add('sel');\n        setTimeout(function () { if (cur < ITEMS.length - 1) { cur++; renderQ(); } else { renderAbout(); } }, 200);\n      };\n      c.appendChild(b);\n    });\n    if (cur > 0) { var back = el('button', 'btn ghost', 'السابق'); back.onclick = function () { cur--; renderQ(); }; c.appendChild(back); }\n    main.appendChild(c);\n  }\n  function chipGroup(parent, items, max, selected, colored, onChange) {\n    var g = el('div', 'chips');\n    items.forEach(function (it, i) {\n      var b = el('button', 'chip' + (colored ? '' : ' plain'), Array.isArray(it) ? it[0] : it);\n      function paint() { var on = selected.indexOf(i) >= 0; b.classList.toggle('sel', on); b.style.background = on && colored ? it[1] : ''; }\n      b.onclick = function () {\n        var k = selected.indexOf(i);\n        if (k >= 0) selected.splice(k, 1);\n        else { if (selected.length >= max) selected.shift(); selected.push(i); }\n        Array.prototype.forEach.call(g.children, function (x) { x._paint(); });\n        onChange && onChange();\n      };\n      b._paint = paint; paint(); g.appendChild(b);\n    });\n    parent.appendChild(g);\n    return g;\n  }\n  function renderAbout() {\n    clear();\n    var c = el('div', 'card');\n    c.appendChild(el('h2', null, 'سؤالان اختياريان'));\n    c.appendChild(el('p', 'muted', 'للمقارنة بين المجموعات في القاعة فقط. يمكنك تخطيهما.'));\n    c.appendChild(el('p', 'lbl', 'كليتك'));\n    var col = [], gen = [];\n    var cKeys = ['eng', 'it', 'bus', 'other'], gKeys = ['m', 'f'];\n    chipGroup(c, ['الهندسة', 'تقنية المعلومات', 'الاقتصاد وإدارة الأعمال', 'أخرى'], 1, col, false);\n    c.appendChild(el('p', 'lbl', 'الجنس'));\n    chipGroup(c, ['طالب', 'طالبة'], 1, gen, false);\n    var b = el('button', 'btn orange', 'أرسل إجاباتي');\n    b.onclick = function () {\n      var a = answers.join('');\n      send('discover', a, { college: col.length ? cKeys[col[0]] : '', gender: gen.length ? gKeys[gen[0]] : '' }, { answers: a });\n    };\n    c.appendChild(b);\n    var back = el('button', 'btn ghost', 'رجوع إلى المواقف'); back.onclick = function () { cur = ITEMS.length - 1; renderQ(); }; c.appendChild(back);\n    main.appendChild(c);\n  }\n  function profileInto(c, a) {\n    var sums = [0, 0, 0, 0, 0, 0];\n    for (var i = 0; i < 12; i++) sums[i % 6] += 